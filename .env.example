# PostgreSQL connection string (server-side only — never exposed to the browser)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/primeplates_hq?schema=public"

# Local development only: owner account created by `npm run db:seed` (which loads sample data).
# In production, the first visit shows a one-time setup page instead.
SEED_OWNER_EMAIL="you@example.com"
SEED_OWNER_PASSWORD="change-me-to-a-long-passphrase"
